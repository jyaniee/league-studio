{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:ws --external:dotenv --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@league-studio/shared-types": "workspace:*",
    "dotenv": "^16.4.7",
    "sirv": "^3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}