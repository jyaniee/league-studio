# League Studio 실험용 배포 설정
# 변경 후 서버를 종료하고 다시 실행해야 적용됩니다.

# 모의 데이터 사용 여부
# true: 화면·연결 확인용 mock 데이터
# false: Riot Live Client API에서 실제 경기 데이터 수집
USE_MOCK=true

# 오버레이 화면 및 /game-state 조회용 HTTP 포트
# 기본 접속 주소: http://localhost:3000/
HTTP_PORT=3000

# 오버레이에 경기 데이터를 전달하는 WebSocket 포트
# 현재 오버레이의 기본 연결 포트는 8081입니다.
# 이 값만 바꾸면 오버레이 연결이 끊길 수 있으므로 기본값을 유지하세요.
WS_PORT=8081

# 경기 데이터 수집·전송 주기 (밀리초)
GAME_STATE_INTERVAL_MS=1000

# WebSocket 연결 상태 확인 주기 (밀리초)
WS_HEARTBEAT_INTERVAL_MS=30000

# 선수 PC의 Agent가 이벤트를 전송할 수신 포트
AGENT_INGEST_PORT=3001

# Observer Tool이 운영 정보를 전송할 수신 포트
OBSERVER_INGEST_PORT=3002

# 실제 경기 API 연결에서 인증서 검증 우회 여부
# 기본값은 false입니다.
# 현재 구현에서 true는 서버 프로세스 전체의 TLS 인증서 검증에 영향을 줍니다.
# 실제 경기 연결 시 인증서 오류를 확인한 경우에만 검토하세요.
ALLOW_INSECURE_LOCAL_TLS=false